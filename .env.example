# Sprout — environment variables
#
# Copy this file to `.env.local` and fill in real values for local
# development. In production, set the same keys in Vercel project
# settings → Environment Variables.
#
# All keys here are public (NEXT_PUBLIC_*) and ship in the browser
# bundle. Anything sensitive (Supabase service_role, Stripe secret
# key, etc.) should live ONLY on the server side and NEVER be
# prefixed with NEXT_PUBLIC_.

# Supabase — public anon client. Safe in the browser bundle because
# Row Level Security in supabase/schema.sql restricts what the anon
# role can do (insert into waitlist; cannot read, update, or delete).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Stripe — Founding Family one-off checkout URL.
# Create the checkout link in Stripe → Payment Links, then paste the
# full URL here. The Waitlist component redirects to this URL when
# the user clicks "Continue to checkout".
NEXT_PUBLIC_STRIPE_CHECKOUT_URL=https://buy.stripe.com/your-link

# Resources social layer (community comments + forum). SERVER ONLY.
# These are NOT NEXT_PUBLIC and must never ship in the browser bundle.
# Until they are set the social features stay dormant and the site
# degrades gracefully (community shows the local/sample showcase,
# read-only). See supabase/schema.sql and docs/RESOURCES-HANDOFF.md.

# Supabase service_role secret. Powers all community/forum reads + writes
# (bypasses Row Level Security). Supabase project settings, API,
# service_role. Run supabase/schema.sql in the SQL editor first.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret

# Secures the admin moderation endpoint (POST /api/resources/admin):
# hide anyone's content, flip the global kill switch, resolve reports.
# Use any long random string; send it as the x-admin-token header.
RESOURCES_ADMIN_TOKEN=pick-a-long-random-string

# Panic switch. Set to 1 to hard-disable ALL community + forum features
# instantly (overrides the DB kill switch). Leave unset normally.
# RESOURCES_SOCIAL_KILL=1

# Resources worksheet generation (Venice AI). SERVER ONLY — never NEXT_PUBLIC.
# Without a key the generator uses the offline deterministic template engine.
# Venice is private / no-train (the privacy promise on /resources/privacy).
VENICE_API_KEY=your-venice-api-key
# Text model that writes the worksheet content. Default is fine; override to test others.
# VENICE_MODEL=qwen3-235b-a22b-instruct-2507

# AI IMAGE generation for teach/activity sheets (Venice /image/generate). Real
# illustrations instead of the 24 curated SVG icons. OFF by default: the blocking
# per-sheet image call adds ~15-25s, costs real money per attempt, and its Venice
# load can rate-limit the text call and drop the whole sheet. Opt in only when
# the non-blocking redesign lands, and watch spend.
# RESOURCES_IMAGES=1              # set to 1 to turn AI images ON (default off = curated line art)
# VENICE_IMAGE_MODEL=venice-sd35  # try flux-2-pro or nano-banana-pro for higher quality (more credits)
# VENICE_IMAGE_MAX=1             # max generated images per sheet (cost + latency cap, 1-4)
# VENICE_IMAGE_SIZE=768          # image px (square); smaller = faster gen + smaller payload (256-1280)

# ─────────────────────────────────────────────────────────────────
# Resource-library subscriber gate (web). DORMANT until launch.
# The login + entitlement code ships inert: nothing gates, no auth calls
# fire, and the live /resources behavior is untouched while
# RESOURCES_AUTH_ENABLED is anything other than "true".
# See lib/supabase/server.ts, lib/resources/entitlement.ts, middleware.ts.
# ─────────────────────────────────────────────────────────────────

# Master switch for the web auth/gate. Leave false until the Apple provider
# (Supabase dashboard) + the RevenueCat secret key below are both in and you're
# ready to require sign-in. While false: zero effect on the live site.
RESOURCES_AUTH_ENABLED=false

# RevenueCat — the entitlement source of truth. SECRET key, server-side ONLY,
# never NEXT_PUBLIC. Looks a subscriber up by their Apple sub
# (/v1/subscribers/{appleSub}). RevenueCat dashboard, Project, API keys, Secret.
REVENUECAT_SECRET_KEY=

# The entitlement identifier that unlocks the library. Defaults to "premium" —
# the SAME entitlement the iOS app grants (Store.swift). One subscription unlocks
# both app and web. Only override if a separate web-only tier is ever added.
REVENUECAT_ENTITLEMENT_ID=premium

# Apple sign-in for the WEB is configured in the Supabase dashboard
# (Auth, Providers, Apple): Services ID + key, under the SAME Apple Developer
# team + primary App ID as the iOS app, or the Apple sub won't match across them.
# No env var here — it's dashboard config. Allowlist this callback URL there and
# in the Apple Services ID return URLs: https://<your-domain>/auth/callback
# (plus http://localhost:3000/auth/callback for local).
